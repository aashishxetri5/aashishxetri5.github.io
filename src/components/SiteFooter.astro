---
/**
 * Footer.
 *
 * The year is computed at build time, so it cannot go stale the way v3's
 * hardcoded "Copyright © 2023" did.
 */
import type { ProfileEntry } from '../lib/content';

interface Props {
  profile: ProfileEntry;
}

const { data } = Astro.props.profile;
const year = new Date().getFullYear();
---

<footer class="border-t border-line py-8">
  <div
    class="flex flex-col items-start justify-between gap-3 text-sm text-faint sm:flex-row sm:items-center"
  >
    <p>© {year} {data.name}</p>

    <p class="font-mono text-xs">
      Built with Astro · content-driven · no tracking
    </p>
  </div>
</footer>
