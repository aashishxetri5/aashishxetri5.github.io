---
/**
 * Project card.
 *
 * The whole card is a link to the project's own page, with the external links
 * as separate, higher-z anchors. Nesting anchors is invalid HTML, so the card
 * link is a positioned overlay instead — this keeps one large, touch-friendly
 * target (§25) without breaking the markup or trapping the GitHub link.
 */
import { Image } from 'astro:assets';

import type { ProjectEntry } from '../lib/content';
import StatusBadge from './StatusBadge.astro';
import TechChips from './TechChips.astro';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const { data } = project;

const externalLinks = [
  { label: 'GitHub', url: data.links.github },
  { label: 'Demo', url: data.links.demo },
  { label: 'Docs', url: data.links.documentation },
].filter((link): link is { label: string; url: string } => Boolean(link.url));
---

<article
  class="group relative flex flex-col overflow-hidden rounded-xl border border-line bg-surface transition-colors hover:border-line-strong"
>
  {
    data.image && (
      <div class="aspect-16/9 overflow-hidden border-b border-line bg-raised">
        <Image
          src={data.image}
          alt={`Screenshot of ${data.name}`}
          width={640}
          height={360}
          loading="lazy"
          class="size-full object-cover"
        />
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-5">
    <div class="mb-2 flex items-start justify-between gap-3">
      <h3 class="font-semibold">
        <a href={`/projects/${project.id}`} class="hover:text-accent">
          <!-- Overlay makes the entire card clickable without nesting anchors. -->
          <span class="absolute inset-0" aria-hidden="true"></span>
          {data.name}
        </a>
      </h3>
      <StatusBadge status={data.status} />
    </div>

    <p class="mb-4 flex-1 text-sm text-muted">{data.shortDescription}</p>

    <TechChips
      items={data.technologies}
      max={4}
      label={`Technologies used in ${data.name}`}
    />

    {
      externalLinks.length > 0 && (
        <ul class="relative z-10 mt-4 flex flex-wrap gap-x-4 text-sm">
          {externalLinks.map((link) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent underline decoration-line-strong underline-offset-4 hover:decoration-accent"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
