---
/**
 * Section shell: anchor, monospace eyebrow label, heading, optional lede.
 *
 * Every reader-mode section uses this, so spacing and heading hierarchy stay
 * consistent and the h2 level is never chosen ad hoc — §24 depends on the
 * hierarchy being correct, not merely present.
 */
interface Props {
  id: string;
  /** Monospace eyebrow, e.g. "EXPERIENCE". */
  label: string;
  heading: string;
  lede?: string | undefined;
}

const { id, label, heading, lede } = Astro.props;
---

<section id={id} class="scroll-mt-20 border-t border-line py-16 sm:py-20">
  <div class="mb-8 sm:mb-10">
    <p class="mono-label mb-2">{label}</p>
    <h2 class="text-2xl font-semibold sm:text-3xl">{heading}</h2>
    {lede && <p class="mt-3 max-w-2xl text-muted">{lede}</p>}
  </div>

  <slot />
</section>
