---
/**
 * Skills as a spec table (section 8).
 *
 * Section 8 is explicit that "Java: 97%" communicates nothing, and asks for "Java /
 * Used in: Project A, Project B, Company X". So this is a three-column table —
 * skill, level, evidence — with the evidence resolved from validated
 * references. A broken link fails the build rather than quietly rendering an
 * unsupported claim.
 *
 * Rows are generated from the collection; section 8: "Avoid manually building skill
 * cards into the UI."
 *
 * The level column is a word, not a percentage or a meter. A four-value enum
 * resists false precision, and stating it in plain language is more honest
 * than a bar chart implying measurement that never happened.
 */
import type { ResolvedSkill, SkillGroup } from '../lib/content';

interface Props {
  groups: SkillGroup[];
}

const { groups } = Astro.props;

const LEVEL_LABEL: Record<ResolvedSkill['level'], string> = {
  advanced: 'advanced',
  proficient: 'proficient',
  working: 'working',
  learning: 'learning',
};

/* Only the top two levels get accent treatment, so emphasis stays meaningful. */
const LEVEL_CLASS: Record<ResolvedSkill['level'], string> = {
  advanced: 'text-accent',
  proficient: 'text-ink',
  working: 'text-muted',
  learning: 'text-faint',
};

const evidenceOf = (skill: ResolvedSkill) =>
  [
    ...skill.evidence.projects.map((project) => project.name),
    ...skill.evidence.companies.map((company) => company.company),
  ].join(' · ');
---

<div class="space-y-12">
  {
    groups.map((group) => (
      <div class="reveal">
        <div
          class="flex items-baseline justify-between border-b border-line-strong pb-2"
        >
          <h3 class="spec-label text-ink">{group.category}</h3>
          <span class="font-mono text-xs text-faint">
            {String(group.skills.length).padStart(2, '0')}
          </span>
        </div>

        <ul>
          {group.skills.map((skill) => (
            <li class="border-b border-line">
              <div
                class="grid grid-cols-[1fr_auto] gap-x-4 gap-y-1 py-3 sm:grid-cols-[11rem_6.5rem_1fr] sm:items-baseline"
              >
                <p class="font-medium">
                  {skill.name}
                  {skill.years !== undefined && skill.years > 0 && (
                    <span class="ml-2 font-mono text-xs text-faint">
                      {skill.years}y
                    </span>
                  )}
                </p>

                <p
                  class:list={[
                    'text-right font-mono text-xs tracking-wide uppercase sm:text-left',
                    LEVEL_CLASS[skill.level],
                  ]}
                >
                  {LEVEL_LABEL[skill.level]}
                </p>

                <p class="col-span-2 text-sm sm:col-span-1">
                  {skill.hasEvidence ? (
                    <span class="text-muted">{evidenceOf(skill)}</span>
                  ) : (
                    /*
                     * Said plainly rather than hidden. A skill with no shipped
                     * evidence is still worth listing, and admitting it is more
                     * credible than implying evidence that does not exist.
                     */
                    <span class="text-faint">—</span>
                  )}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
