---
/**
 * Technology list. Renders nothing at all when empty, rather than an empty row.
 */
interface Props {
  items: readonly string[];
  /** Caps the visible count and summarises the rest, for dense card layouts. */
  max?: number | undefined;
  label?: string | undefined;
}

const { items, max, label } = Astro.props;

const visible = max ? items.slice(0, max) : items;
const hidden = items.length - visible.length;
---

{
  items.length > 0 && (
    <ul class="flex flex-wrap gap-1.5" aria-label={label ?? 'Technologies'}>
      {visible.map((item) => (
        <li class="rounded border border-line bg-raised px-2 py-0.5 font-mono text-xs text-muted">
          {item}
        </li>
      ))}
      {hidden > 0 && (
        <li class="px-1 py-0.5 font-mono text-xs text-faint">+{hidden} more</li>
      )}
    </ul>
  )
}
