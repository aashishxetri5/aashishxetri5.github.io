---
/**
 * Experience as a timeline (§14).
 *
 * Ordering and the date label are both derived — current roles first, then most
 * recent — so no component contains a company name or a hardcoded year. The
 * current role is marked with a filled, ringed node and a live dot, satisfying
 * §14's "current employment should be visually distinguishable" without
 * anything in this file knowing which employer is current.
 *
 * A definition list is the honest markup here: each entry is a period paired
 * with a role.
 */
import { formatDateRange } from '../lib/dates';
import type { ExperienceEntry } from '../lib/content';
import TechChips from './TechChips.astro';

interface Props {
  entries: ExperienceEntry[];
}

const { entries } = Astro.props;

const EMPLOYMENT_LABEL: Record<
  ExperienceEntry['data']['employmentType'],
  string
> = {
  'full-time': 'Full-time',
  'part-time': 'Part-time',
  contract: 'Contract',
  freelance: 'Freelance',
  internship: 'Internship',
  hackathon: 'Hackathon',
  'self-employed': 'Self-employed',
};
---

<ol class="relative">
  {
    entries.map((entry, index) => {
      const { data } = entry;
      const isLast = index === entries.length - 1;

      return (
        <li class="relative pl-8 pb-10 last:pb-0">
          {/* Connector, omitted on the final item so the line does not dangle. */}
          {!isLast && (
            <span
              class="absolute top-3 left-[5px] h-full w-px bg-line"
              aria-hidden="true"
            />
          )}

          <span
            class:list={[
              'absolute top-2 left-0 size-[11px] rounded-full border-2',
              data.current
                ? 'border-live bg-live'
                : 'border-line-strong bg-bg',
            ]}
            aria-hidden="true"
          />

          <div class="flex flex-wrap items-baseline gap-x-2">
            <p class="mono-label">{formatDateRange(data)}</p>
            {data.current && (
              <span class="font-mono text-[0.7rem] tracking-wide text-live uppercase">
                • Current
              </span>
            )}
          </div>

          <h3 class="mt-1 text-lg font-semibold">{data.role}</h3>

          <p class="text-muted">
            {data.website ? (
              <a
                href={data.website}
                target="_blank"
                rel="noopener noreferrer"
                class="text-ink underline decoration-line-strong underline-offset-4 hover:text-accent"
              >
                {data.company}
              </a>
            ) : (
              <span class="text-ink">{data.company}</span>
            )}
            <span class="text-faint">
              {' · '}
              {EMPLOYMENT_LABEL[data.employmentType]}
              {data.location && ` · ${data.location}`}
            </span>
          </p>

          <p class="mt-3 max-w-2xl">{data.summary}</p>

          {data.achievements.length > 0 && (
            <ul class="mt-3 max-w-2xl space-y-1.5 text-muted">
              {data.achievements.map((achievement) => (
                <li class="flex gap-2">
                  <span class="mt-[0.45rem] size-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                  <span>{achievement}</span>
                </li>
              ))}
            </ul>
          )}

          {data.responsibilities.length > 0 && (
            <ul class="mt-3 max-w-2xl space-y-1.5 text-muted">
              {data.responsibilities.map((item) => (
                <li class="flex gap-2">
                  <span class="mt-[0.45rem] size-1 shrink-0 rounded-full bg-line-strong" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )}

          <div class="mt-4">
            <TechChips
              items={data.technologies}
              label={`Technologies used at ${data.company}`}
            />
          </div>

          {data.links.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
              {data.links.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-accent underline decoration-line-strong underline-offset-4 hover:decoration-accent"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      );
    })
  }
</ol>
