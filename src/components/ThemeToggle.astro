---
/**
 * Light/dark toggle (section 27).
 *
 * On first visit no preference is stored and the system setting applies. The
 * first click stores an explicit choice, which then wins over the system on
 * every page and every visit.
 *
 * Plain DOM rather than a framework island: this is one attribute and one
 * localStorage key, and Rule 4 requires a reason for every dependency.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="grid size-9 place-items-center border border-line text-muted transition-colors hover:border-line-strong hover:text-ink"
  aria-label="Switch between light and dark theme"
>
  <!-- Sun: shown when the current theme is dark, i.e. click for light. -->
  <svg
    class="hidden size-4 dark-visible"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>

  <!-- Moon: shown when the current theme is light. -->
  <svg
    class="size-4 light-visible"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" />
  </svg>
</button>

<style>
  /*
   * Icon visibility must track all three theme states, so it is driven by the
   * same conditions as the tokens themselves rather than by a JS class.
   */
  :global(:root[data-theme='dark']) .light-visible {
    display: none;
  }
  :global(:root[data-theme='dark']) .dark-visible {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .light-visible {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .dark-visible {
      display: block;
    }
  }
</style>

<script is:inline>
  (function () {
    var button = document.getElementById('theme-toggle');
    if (!button) return;

    button.addEventListener('click', function () {
      var root = document.documentElement;
      var explicit = root.getAttribute('data-theme');

      // With no explicit choice yet, invert whatever the system is currently
      // giving us — so the first click always visibly changes something.
      var isDark =
        explicit === 'dark' ||
        (explicit === null &&
          window.matchMedia('(prefers-color-scheme: dark)').matches);

      var next = isDark ? 'light' : 'dark';
      root.setAttribute('data-theme', next);

      try {
        localStorage.setItem('theme', next);
      } catch (error) {
        /* Storage blocked: the choice still applies for this page view. */
      }
    });
  })();
</script>
