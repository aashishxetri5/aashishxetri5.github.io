---
/**
 * Education. Shares the derived date logic with the experience changelog, so an
 * in-progress degree gets "— Present" from `current: true` without this file
 * knowing anything about dates.
 */
import { formatDateRange } from '../lib/dates';
import type { EducationEntry } from '../lib/content';

interface Props {
  entries: EducationEntry[];
}

const { entries } = Astro.props;
---

<ul class="border-t border-line">
  {
    entries.map(({ data }) => (
      <li class="reveal-item border-b border-line">
        <div class="py-6 sm:grid sm:grid-cols-[6.5rem_1fr] sm:gap-6">
          <p class="mb-2 font-mono text-sm text-faint sm:mb-0">
            {formatDateRange(data)}
          </p>

          <div class="min-w-0">
            <h3 class="text-lg font-bold">{data.degree}</h3>

            <p class="spec-value mt-1">
              <span class="text-ink">{data.institution}</span>
              {data.location && <span class="text-faint"> · {data.location}</span>}
            </p>

            {data.field && (
              <p class="spec-label mt-2">{data.field}</p>
            )}

            {data.grade && (
              <p class="mt-3 font-mono text-sm">
                <span class="text-faint">grade: </span>
                <span class="text-ink">{data.grade}</span>
              </p>
            )}

            {data.highlights.length > 0 && (
              <ul class="mt-4 max-w-xl space-y-2">
                {data.highlights.map((highlight) => (
                  <li class="flex gap-3 text-sm text-muted">
                    <span class="font-mono text-accent" aria-hidden="true">
                      +
                    </span>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </li>
    ))
  }
</ul>
