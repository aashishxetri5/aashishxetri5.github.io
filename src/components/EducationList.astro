---
/**
 * Education. Shares the derived date logic with the experience timeline, so an
 * in-progress degree gets "— Present" from `current: true` without this file
 * knowing anything about dates.
 */
import { formatDateRange } from '../lib/dates';
import type { EducationEntry } from '../lib/content';

interface Props {
  entries: EducationEntry[];
}

const { entries } = Astro.props;
---

<ul class="space-y-4">
  {
    entries.map(({ data }) => (
      <li class="rounded-lg border border-line bg-surface p-5">
        <div class="flex flex-wrap items-baseline justify-between gap-x-3">
          <h3 class="font-semibold">{data.degree}</h3>
          <p class="mono-label">{formatDateRange(data)}</p>
        </div>

        <p class="mt-1 text-muted">
          {data.institution}
          {data.location && <span class="text-faint"> · {data.location}</span>}
        </p>

        {data.field && <p class="mt-1 text-sm text-faint">{data.field}</p>}

        {data.grade && (
          <p class="mt-2 text-sm">
            <span class="text-faint">Grade: </span>
            {data.grade}
          </p>
        )}

        {data.highlights.length > 0 && (
          <ul class="mt-3 space-y-1.5 text-sm text-muted">
            {data.highlights.map((highlight) => (
              <li class="flex gap-2">
                <span class="mt-[0.4rem] size-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ul>
