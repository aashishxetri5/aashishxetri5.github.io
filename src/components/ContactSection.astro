---
/**
 * Contact, framed as a terminal exchange.
 *
 * No form, deliberately. v3 posted to a third-party form service; a mailto plus
 * direct links has no third-party dependency, no spam surface, nothing to break
 * silently and nothing to keep working. §19 prefers the simplest thing that
 * satisfies the requirement, and the requirement is "be reachable".
 *
 * v3's embedded Google Maps iframe is also gone: it shipped third-party
 * tracking and a large payload to place a pin near a home address.
 */
import type { ProfileEntry } from '../lib/content';

interface Props {
  profile: ProfileEntry;
}

const { data } = Astro.props.profile;

const SOCIAL_LABELS: Record<string, string> = {
  github: 'GitHub',
  linkedin: 'LinkedIn',
  hashnode: 'Hashnode',
  website: 'Website',
  x: 'X',
};

const socials = Object.entries(data.socials)
  .filter((entry): entry is [string, string] => typeof entry[1] === 'string')
  .map(([key, url]) => ({ label: SOCIAL_LABELS[key] ?? key, url }));
---

<div>
  <div class="border border-line bg-surface p-5 font-mono text-sm sm:p-6">
    <p class="text-faint">
      <span class="text-accent">$</span> mail --to aashish
    </p>
    <p class="mt-3 text-muted">
      {
        data.availability.open
          ? 'Accepting messages. Email is the fastest route.'
          : 'Not looking right now, but always happy to talk shop.'
      }
    </p>
  </div>

  <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
    <a
      href={`mailto:${data.email}`}
      class="group inline-flex items-center gap-2 border border-accent bg-accent px-5 py-2.5 font-mono text-sm font-medium tracking-wide text-bg transition-colors hover:bg-accent-hover active:translate-y-px"
    >
      {data.email}
      <span
        class="transition-transform group-hover:translate-x-1"
        aria-hidden="true">→</span
      >
    </a>

    {
      data.resume && (
        <a
          href={`/${data.resume.file}`}
          download
          class="border border-line-strong px-5 py-2.5 font-mono text-sm tracking-wide uppercase transition-colors hover:border-accent hover:text-accent active:translate-y-px"
        >
          Download {data.resume.label}
        </a>
      )
    }
  </div>

  {
    socials.length > 0 && (
      <dl class="mt-10 max-w-md border-t border-line">
        {socials.map((social) => (
          <div class="flex items-baseline gap-4 border-b border-line py-2.5">
            <dt class="spec-label w-20 shrink-0">{social.label}</dt>
            <dd class="min-w-0 flex-1 truncate">
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="spec-value text-ink underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
              >
                {social.url.replace(/^https?:\/\/(www\.)?/, '')} ↗
              </a>
            </dd>
          </div>
        ))}
      </dl>
    )
  }
</div>
