---
/**
 * 404 (32, 11 asks for a 404 at deploy verification).
 *
 * Styled as a shell error, which fits the AASHISH.OS concept while still doing
 * the only job a 404 has: say what happened and offer a way out.
 */
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProfile } from '../lib/content';

const profile = await getProfile();
---

<BaseLayout title="Not found" description="This page does not exist." noindex>
  <SiteHeader showSectionNav={false} />

  <main
    id="main"
    class="mx-auto flex min-h-[70vh] max-w-2xl flex-col justify-center px-5 sm:px-8"
  >
    <div class="border border-line bg-surface p-6 font-mono text-sm sm:p-8">
      <p class="text-faint">
        <span class="text-accent">$</span> open {Astro.url.pathname}
      </p>
      <p class="mt-3 text-accent">error: no such route</p>
      <p class="mt-1 text-muted">exit status 404</p>
    </div>

    <h1 class="mt-8 text-2xl font-semibold sm:text-3xl">
      That page doesn't exist
    </h1>
    <p class="mt-3 text-muted">
      It may have moved, or the link may be wrong. Everything on the site is
      reachable from the homepage.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/"
        class="border border-accent bg-accent px-5 py-2.5 font-mono text-sm tracking-wide uppercase text-bg transition-colors hover:bg-accent-hover active:translate-y-px"
      >
        Back to home
      </a>
      <a
        href="/#projects"
        class="border border-line-strong px-5 py-2.5 font-mono text-sm tracking-wide uppercase transition-colors hover:border-accent hover:text-accent active:translate-y-px"
      >
        See projects
      </a>
      <a
        href={`mailto:${profile.data.email}`}
        class="px-2 py-2 font-medium text-muted underline decoration-line-strong underline-offset-4 hover:text-ink"
      >
        Report a broken link
      </a>
    </div>
  </main>
</BaseLayout>
