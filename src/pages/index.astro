---
/**
 * PHASE 1 SMOKE PAGE — not the real homepage.
 *
 * Phase 1's exit condition is that the content layer works and that invalid
 * content fails the build. This page exists to make that verifiable: it loads
 * every collection, renders the derived date labels, and resolves the skill
 * evidence references. It is deliberately near-unstyled.
 *
 * Phase 2 replaces this entirely with reader mode.
 */
import { getCollection, getEntry } from 'astro:content';

import { formatDateRange, sortByRecency } from '../lib/dates';
import '../styles/global.css';

const [profileEntries, experience, projects, skills, education, achievements, posts] =
  await Promise.all([
    getCollection('profile'),
    getCollection('experience'),
    getCollection('projects'),
    getCollection('skills'),
    getCollection('education'),
    getCollection('achievements'),
    getCollection('posts'),
  ]);

const profile = profileEntries[0];

// §6/§14 in action: labels and ordering are derived, never authored.
const timeline = sortByRecency(
  experience.map((entry) => ({
    id: entry.id,
    company: entry.data.company,
    role: entry.data.role,
    startDate: entry.data.startDate,
    endDate: entry.data.endDate,
    current: entry.data.current,
  })),
);

// Resolve the skill → project references, proving build-time referential
// integrity rather than free-text claims (§8, §33).
const skillEvidence = await Promise.all(
  skills.map(async (skill) => ({
    name: skill.data.name,
    category: skill.data.category,
    level: skill.data.level,
    projects: (
      await Promise.all(skill.data.projects.map((ref) => getEntry(ref)))
    )
      .filter((entry) => entry !== undefined)
      .map((entry) => entry.data.name),
  })),
);

const counts = [
  ['profile', profileEntries.length],
  ['experience', experience.length],
  ['projects', projects.length],
  ['skills', skills.length],
  ['education', education.length],
  ['achievements', achievements.length],
  ['posts', posts.length],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AASHISH.OS — Phase 1 content smoke test</title>
    <meta name="robots" content="noindex" />
  </head>
  <body class="mx-auto max-w-3xl p-8 font-mono text-sm leading-relaxed">
    <h1 class="mb-2 text-xl font-bold">AASHISH.OS — Phase 1</h1>
    <p class="mb-8 text-neutral-600">
      Content-layer smoke test. Not the real homepage — Phase 2 replaces this.
    </p>

    <section class="mb-8">
      <h2 class="mb-2 font-bold">Collections loaded</h2>
      <ul>
        {
          counts.map(([name, count]) => (
            <li>
              {name}: <strong>{count}</strong>
              {count === 0 && ' — empty (expected; must omit its UI section)'}
            </li>
          ))
        }
      </ul>
    </section>

    {
      profile && (
        <section class="mb-8">
          <h2 class="mb-2 font-bold">Profile</h2>
          <ul>
            <li>{profile.data.name} — {profile.data.headline}</li>
            <li>{profile.data.location}</li>
            <li>
              résumé:{' '}
              {profile.data.resume
                ? profile.data.resume.file
                : 'absent — affordance must be omitted, not broken'}
            </li>
            <li>
              availability: {profile.data.availability.open ? 'open' : 'closed'}
            </li>
          </ul>
        </section>
      )
    }

    <section class="mb-8">
      <h2 class="mb-2 font-bold">Timeline — derived labels and ordering</h2>
      <ol>
        {
          timeline.map((item) => (
            <li>
              <strong>{formatDateRange(item)}</strong> · {item.role} @{' '}
              {item.company}
              {item.current && ' ← current'}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mb-8">
      <h2 class="mb-2 font-bold">Skills — resolved evidence references</h2>
      <ul>
        {
          skillEvidence.map((skill) => (
            <li>
              {skill.name} ({skill.category}, {skill.level})
              {skill.projects.length > 0
                ? ` — used in: ${skill.projects.join(' · ')}`
                : ' — no project evidence yet'}
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class="mb-2 font-bold">Projects by status</h2>
      <ul>
        {
          projects.map((project) => (
            <li>
              [{project.data.status}] {project.data.name}
              {project.data.featured && ' ★ featured'}
            </li>
          ))
        }
      </ul>
    </section>
  </body>
</html>
