---
/**
 * Reader mode (§10) — the conventional, recruiter-friendly experience.
 *
 * Phase 2's exit condition is that this page is already genuinely useful with
 * every experimental feature removed, which is what makes the AASHISH.OS shell
 * additive rather than load-bearing. It ships zero JavaScript beyond the theme
 * toggle, so it works with scripting disabled (§39).
 *
 * Every section is derived: an empty collection omits its section entirely
 * rather than rendering a bare heading — the exact bug v3 shipped with its
 * permanently empty certifications block.
 */
import AchievementsList from '../components/AchievementsList.astro';
import ContactSection from '../components/ContactSection.astro';
import EducationList from '../components/EducationList.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Section from '../components/Section.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SkillsEvidence from '../components/SkillsEvidence.astro';
import WritingList from '../components/WritingList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getAchievements,
  getEducation,
  getExperience,
  getPosts,
  getProfile,
  getProjects,
  getSkillGroups,
} from '../lib/content';

const [profile, experience, projects, skillGroups, education, achievements, posts] =
  await Promise.all([
    getProfile(),
    getExperience(),
    getProjects(),
    getSkillGroups(),
    getEducation(),
    getAchievements(),
    getPosts(),
  ]);
---

<BaseLayout>
  <SiteHeader />

  <main id="main" class="mx-auto max-w-4xl px-5 sm:px-8">
    <Hero profile={profile} />

    <Section
      id="about"
      label="About"
      heading="Who I am"
    >
      {/*
        longBio is authored as plain text with blank-line paragraph breaks, so
        it is split rather than rendered as HTML — no sanitization question
        arises for profile copy (§31).
      */}
      <div class="max-w-2xl space-y-4 text-muted">
        {
          profile.data.longBio
            .split(/\n\s*\n/)
            .map((paragraph) => <p>{paragraph.trim()}</p>)
        }
      </div>
    </Section>

    {
      experience.length > 0 && (
        <Section
          id="experience"
          label="Experience"
          heading="Where I've worked"
        >
          <ExperienceTimeline entries={experience} />
        </Section>
      )
    }

    {
      projects.length > 0 && (
        <Section
          id="projects"
          label="Projects"
          heading="Things I've built"
          lede="Each project has its own page with the detail behind it."
        >
          <div class="grid gap-5 sm:grid-cols-2">
            {projects.map((project) => <ProjectCard project={project} />)}
          </div>
        </Section>
      )
    }

    {
      skillGroups.length > 0 && (
        <Section
          id="skills"
          label="Skills"
          heading="What I work with"
          lede="Listed with where I've actually used them, rather than as a percentage."
        >
          <SkillsEvidence groups={skillGroups} />
        </Section>
      )
    }

    {
      education.length > 0 && (
        <Section id="education" label="Education" heading="Where I studied">
          <EducationList entries={education} />
        </Section>
      )
    }

    {/* Currently empty by design — proves the section omits itself (§8). */}
    {
      achievements.length > 0 && (
        <Section
          id="achievements"
          label="Achievements"
          heading="Certifications and recognition"
        >
          <AchievementsList entries={achievements} />
        </Section>
      )
    }

    {
      posts.length > 0 && (
        <Section id="writing" label="Writing" heading="Things I've written">
          <WritingList posts={posts} />
        </Section>
      )
    }

    <Section id="contact" label="Contact" heading="Get in touch">
      <ContactSection profile={profile} />
    </Section>

    <SiteFooter profile={profile} />
  </main>
</BaseLayout>
